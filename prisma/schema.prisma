generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Authentication & Users ───────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  role           String    @default("STUDENT") // SUPER_ADMIN, COLLEGE_ADMIN, FACULTY, STUDENT
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  institutionMemberships InstitutionMembership[]
  auditLogs             AuditLog[]
  verificationReviews   VerificationRequest[]   @relation("ReviewedBy")
  importJobs            ImportJob[]
  correctionRequests    CorrectionRequest[]     @relation("RequestedBy")
  correctionReviews     CorrectionRequest[]     @relation("ReviewedByUser")
  notifications         Notification[]
  studentProfile        Student?                @relation("StudentUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Institutions ─────────────────────────────────────────────────────

model Institution {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  state           String
  district        String
  address         String?
  website         String?
  email           String?
  phone           String?
  status          String   @default("PENDING") // PENDING, APPROVED, SUSPENDED, REJECTED
  approvedAt      DateTime?
  suspendedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     InstitutionMembership[]
  departments     Department[]
  students        Student[]
  approvedIntakes ApprovedIntake[]
  importJobs      ImportJob[]
  auditLogs       AuditLog[]
}

model InstitutionMembership {
  id            String   @id @default(cuid())
  userId        String
  institutionId String
  role          String   // ADMIN, FACULTY, VERIFIER
  isActive      Boolean  @default(true)
  joinedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
}

// ─── Academic Structure ───────────────────────────────────────────────

model Department {
  id            String   @id @default(cuid())
  name          String
  code          String
  institutionId String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courses     Course[]
  students    Student[]

  @@unique([code, institutionId])
}

model Course {
  id           String   @id @default(cuid())
  name         String
  code         String
  departmentId String
  duration     Int      @default(4) // years
  level        String   @default("UG") // UG, PG, DIPLOMA, PHD
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  department     Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students       Student[]
  approvedIntakes ApprovedIntake[]

  @@unique([code, departmentId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  year      String   @unique // e.g., "2024-2025"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  approvedIntakes ApprovedIntake[]
  students        Student[]
}

model ApprovedIntake {
  id              String   @id @default(cuid())
  institutionId   String
  courseId         String
  academicYearId  String
  approvedCount   Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([institutionId, courseId, academicYearId])
}

// ─── Students ─────────────────────────────────────────────────────────

model Student {
  id                String    @id @default(cuid())
  internalId        String    @unique // Institution-specific student ID
  apaarId           String?   // Encrypted/masked APAAR ID
  apaarIdHash       String?   // HMAC fingerprint for exact-match lookup
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  gender            String?
  email             String?
  phone             String?
  guardianName      String?
  guardianPhone     String?
  address           String?
  institutionId     String
  departmentId      String?
  courseId           String?
  academicYearId    String?
  admissionYear     Int?
  semester          Int?
  enrollmentStatus  String    @default("ACTIVE") // ACTIVE, INACTIVE, GRADUATED, DROPPED, TRANSFERRED
  verificationStatus String  @default("NOT_SUBMITTED") // NOT_SUBMITTED, PENDING, VERIFIED, REJECTED, NEEDS_CORRECTION, CONFLICT
  isArchived        Boolean   @default(false)
  archivedAt        DateTime?
  userId            String?   @unique // Link to user account if student has login
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  institution          Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department           Department?           @relation(fields: [departmentId], references: [id])
  course               Course?               @relation(fields: [courseId], references: [id])
  academicYear         AcademicYear?         @relation(fields: [academicYearId], references: [id])
  user                 User?                 @relation("StudentUser", fields: [userId], references: [id])
  recordHistory        StudentRecordHistory[]
  verificationRequests VerificationRequest[]
  duplicateAlerts1     DuplicateAlert[]      @relation("Student1")
  duplicateAlerts2     DuplicateAlert[]      @relation("Student2")
  correctionRequests   CorrectionRequest[]
  consentRecords       ConsentRecord[]

  @@index([apaarIdHash])
  @@index([institutionId])
  @@index([verificationStatus])
  @@index([enrollmentStatus])
}

model StudentRecordHistory {
  id         String   @id @default(cuid())
  studentId  String
  field      String
  oldValue   String?
  newValue   String?
  changedBy  String?
  reason     String?
  createdAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ─── Verification ─────────────────────────────────────────────────────

model VerificationRequest {
  id             String    @id @default(cuid())
  studentId      String
  requestedBy    String?
  status         String    @default("PENDING") // PENDING, IN_REVIEW, VERIFIED, REJECTED, NEEDS_CORRECTION
  validationData String?   // JSON string of validation results
  reviewedById   String?
  reviewNotes    String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ReviewedBy", fields: [reviewedById], references: [id])
}

// ─── Duplicate Detection ──────────────────────────────────────────────

model DuplicateAlert {
  id             String   @id @default(cuid())
  student1Id     String
  student2Id     String
  matchType      String   // EXACT_APAAR, EXACT_INTERNAL_ID, NAME_DOB, FUZZY_NAME
  confidence     Float
  matchingFields String   // JSON string
  reason         String
  status         String   @default("PENDING") // PENDING, CONFIRMED, DISMISSED, MERGED
  resolvedBy     String?
  resolvedAt     DateTime?
  resolvedNotes  String?
  createdAt      DateTime @default(now())

  student1 Student @relation("Student1", fields: [student1Id], references: [id], onDelete: Cascade)
  student2 Student @relation("Student2", fields: [student2Id], references: [id], onDelete: Cascade)

  @@unique([student1Id, student2Id])
}

// ─── Imports ──────────────────────────────────────────────────────────

model ImportJob {
  id             String   @id @default(cuid())
  institutionId  String
  userId         String
  fileName       String
  fileSize       Int
  status         String   @default("PENDING") // PENDING, VALIDATING, VALIDATED, IMPORTING, COMPLETED, FAILED
  totalRows      Int      @default(0)
  validRows      Int      @default(0)
  errorRows      Int      @default(0)
  skippedRows    Int      @default(0)
  importedRows   Int      @default(0)
  columnMapping  String?  // JSON string
  errorReportUrl String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id])
  errors      ImportRowError[]
}

model ImportRowError {
  id          String   @id @default(cuid())
  importJobId String
  rowNumber   Int
  field       String?
  value       String?
  errorType   String   // MISSING_REQUIRED, INVALID_FORMAT, DUPLICATE, CONFLICT
  message     String
  createdAt   DateTime @default(now())

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
}

// ─── Consent & Correction ─────────────────────────────────────────────

model ConsentRecord {
  id          String   @id @default(cuid())
  studentId   String
  consentType String   // DATA_SHARING, VERIFICATION, EXPORT
  granted     Boolean
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?
  details     String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model CorrectionRequest {
  id            String    @id @default(cuid())
  studentId     String
  requestedById String
  field         String
  currentValue  String?
  requestedValue String
  reason        String
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById  String?
  reviewNotes   String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?   @relation("ReviewedByUser", fields: [reviewedById], references: [id])
}

// ─── Audit & Notifications ───────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  institutionId String?
  action        String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, EXPORT, VERIFY, IMPORT, ACCESS
  resource      String   // STUDENT, INSTITUTION, VERIFICATION, IMPORT, USER, SETTINGS
  resourceId    String?
  details       String?  // JSON string
  ipAddress     String?
  userAgent     String?
  outcome       String   @default("SUCCESS") // SUCCESS, FAILURE, DENIED
  createdAt     DateTime @default(now())

  user        User?        @relation(fields: [userId], references: [id])
  institution Institution? @relation(fields: [institutionId], references: [id])

  @@index([userId])
  @@index([institutionId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, ERROR, SUCCESS
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
